<?xml version="1.0" encoding="UTF-8" ?>
<!-- Стили дизайна Apple (DESIGN.md §3). Правила:
     • цвета — только {DynamicResource …}: ThemeService меняет их при смене темы и контраста;
     • текст — стили ролей ниже на основе Text* из Typography.xaml (кегль, начертание, Dynamic Type);
     • размеры — из Metrics.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:Chrono.Controls"
                    xmlns:design="clr-namespace:Chrono.Design">

    <!-- Толщина разделителя — один физический пиксель; точное значение ThemeService.Attach пишет по плотности экрана. -->
    <x:Double x:Key="HairlineWidth">0.5</x:Double>

    <!-- Нижний отступ прокручиваемого содержимого корневых страниц: последним элементом ScrollView ставится ContentView с этим стилем.
         На Android поверх низа экрана лежит плавающая капсула FloatingTabBar — высота SizeTabbar (62) и зазор под ней SizeTabbarInset / 2 (10,5):
         содержимое можно прокрутить выше капсулы. На iOS таб-бар системный и сам сдвигает содержимое: элемент скрыт и места (и промежутка в стеке) не занимает. -->
    <Style x:Key="TabBarClearance" TargetType="ContentView">
        <Setter Property="HeightRequest" Value="72.5" />
        <Setter Property="IsVisible" Value="{OnPlatform Android=True, Default=False}" />
    </Style>

    <!-- ===== Страницы ===== -->

    <!-- Экраны со списками — SystemGroupedBackground; экраны без групп (сигнал) — стиль PlainPage. -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SystemGroupedBackground}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style x:Key="PlainPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource SystemBackground}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- ===== Текст: роли ===== -->

    <Style TargetType="Label" BasedOn="{StaticResource TextBody}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
    </Style>

    <!-- Large Title корневого экрана: «Будильники», «Распорядок», «Циферблат», «Настройки». -->
    <Style x:Key="LargeTitle" TargetType="Label" BasedOn="{StaticResource TextLargeTitleEmphasized}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
    </Style>

    <!-- Подстрока под Large Title: «Ближайший — через 8 ч 15 мин», дата на «Распорядке». -->
    <Style x:Key="LargeSubtitle" TargetType="Label" BasedOn="{StaticResource TextSubheadline}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
    </Style>

    <!-- Inline-заголовок вложенного экрана и шторки: по центру панели, короче 15 символов. -->
    <Style x:Key="NavTitle" TargetType="Label" BasedOn="{StaticResource TextHeadline}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Заголовок секции: 17 Semibold, SecondaryLabel, обычный регистр — не капс. -->
    <Style x:Key="SectionHeader" TargetType="Label" BasedOn="{StaticResource TextHeadline}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
        <Setter Property="Margin" Value="16,0,16,6" />
    </Style>

    <!-- Сноска под секцией. -->
    <Style x:Key="SectionFooter" TargetType="Label" BasedOn="{StaticResource TextFootnote}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
        <Setter Property="Margin" Value="16,6,16,0" />
    </Style>

    <!-- Строка списка: название слева (Label), значение справа (SecondaryLabel), подзаголовок под названием. -->
    <Style x:Key="RowTitle" TargetType="Label" BasedOn="{StaticResource TextBody}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="RowValue" TargetType="Label" BasedOn="{StaticResource TextBody}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <!-- Значение в колонке *, название — Auto: при крупном шрифте усекается значение, а не название строки. -->
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="RowSubtitle" TargetType="Label" BasedOn="{StaticResource TextSubheadline}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
    </Style>

    <!-- Действие в строке списка: текст Tint по центру; удаление — DestructiveRowAction отдельной секцией внизу. -->
    <Style x:Key="RowAction" TargetType="Label" BasedOn="{StaticResource TextBody}">
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="DestructiveRowAction" TargetType="Label" BasedOn="{StaticResource RowAction}">
        <Setter Property="TextColor" Value="{DynamicResource Destructive}" />
    </Style>

    <Style x:Key="Footnote" TargetType="Label" BasedOn="{StaticResource TextFootnote}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource TextCaption1}">
        <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
    </Style>

    <!-- Ошибка формы — сноской под группой: что не так и как исправить. -->
    <Style x:Key="ErrorText" TargetType="Label" BasedOn="{StaticResource TextFootnote}">
        <Setter Property="TextColor" Value="{DynamicResource Destructive}" />
        <Setter Property="Margin" Value="16,6,16,0" />
    </Style>

    <!-- Время: в строке будильника 48 Light, на экране сигнала 76 Light; цифры табличные. -->
    <Style x:Key="TimeRow" TargetType="Label" BasedOn="{StaticResource TextTimeRow}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
    </Style>

    <Style x:Key="TimeHero" TargetType="Label" BasedOn="{StaticResource TextTimeHero}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- ===== Список inset grouped ===== -->

    <!-- Группа строк: радиус 26, без обводки и тени, ячейки на SecondarySystemGroupedBackground. -->
    <Style x:Key="Section" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SecondarySystemGroupedBackground}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Секция в шторке на большом детенте (DESIGN.md §2.2): фон шторки — elevatedGroupedBackground, ячейки — elevatedSecondaryGroupedBackground.
         В тёмной теме обычная Section (#1C1C1E) сливалась бы с шторкой; в светлой обе белые. -->
    <Style x:Key="SheetSection" TargetType="Border" BasedOn="{StaticResource Section}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ElevatedSecondaryGroupedBackground}" />
    </Style>

    <!-- Строка: 52 при обычном размере текста и растёт вместе с ним; поля 16. -->
    <Style x:Key="Row" TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeRow}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <!-- Разделитель: Separator в один физический пиксель, от начала текста до края. -->
    <Style x:Key="RowSeparator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="{DynamicResource HairlineWidth}" />
        <Setter Property="Color" Value="{DynamicResource Separator}" />
        <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- Разделитель строки со значком 30 («Настройки», «Надёжность»): начинается там же, где название (16 поле + 30 значок + 12 просвет = 58). -->
    <Style x:Key="IconRowSeparator" TargetType="BoxView" BasedOn="{StaticResource RowSeparator}">
        <Setter Property="Margin" Value="58,0,0,0" />
    </Style>

    <!-- Подсказка в контенте (вместо баннера): та же карточка, что секция, с полями. -->
    <Style x:Key="Tip" TargetType="Border" BasedOn="{StaticResource Section}">
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ===== Кнопки: капсулы, стиль показывает важность ===== -->

    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
        <Setter Property="TextColor" Value="{DynamicResource OnTint}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="{OnPlatform Android=InterSemiBold}" />
        <Setter Property="FontAttributes" Value="{OnPlatform iOS=Bold, Default=None}" />
        <Setter Property="CharacterSpacing" Value="{OnPlatform Android=-0.4167, Default=0}" />
        <Setter Property="HeightRequest" Value="{StaticResource SizeButtonL}" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="Opacity" Value="0.78" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource QuaternarySystemFill}" />
                            <Setter Property="TextColor" Value="{DynamicResource TertiaryLabel}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Второе по важности: «Исправить», «Дать доступ». -->
    <Style x:Key="TintedButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TintFill}" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
    </Style>

    <!-- Нейтральное: «Отмена», «Сегодня». -->
    <Style x:Key="GrayButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TertiarySystemFill}" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
    </Style>

    <!-- Текстовая кнопка в контенте. -->
    <Style x:Key="PlainButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
        <Setter Property="FontFamily" Value="{OnPlatform Android=InterRegular}" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

    <!-- Удаление: роль destructive красит текст; prominent-заливки у удаления не бывает. -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="TextColor" Value="{DynamicResource Destructive}" />
    </Style>

    <!-- Область нажатия кнопок S и M: вид по дизайну (28 и 34), а касание — 44 по высоте. Кнопку кладут в controls:HitTarget
         (Button с VerticalOptions="Center"): обёртка 44 передаёт ей нажатие вокруг капсулы. -->
    <Style TargetType="controls:HitTarget">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeHit}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource SizeHit}" />
    </Style>

    <!-- Размер M (34): кнопки в карточках и строках; область нажатия до 44 добирает HitTarget. -->
    <Style x:Key="FilledButtonM" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="HeightRequest" Value="{StaticResource SizeButtonM}" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="{OnPlatform Android=-0.2564, Default=0}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="TintedButtonM" TargetType="Button" BasedOn="{StaticResource FilledButtonM}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TintFill}" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
    </Style>

    <Style x:Key="GrayButtonM" TargetType="Button" BasedOn="{StaticResource FilledButtonM}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TertiarySystemFill}" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
    </Style>

    <!-- Текстовая кнопка размера M: «Снять выбор» рядом с другими кнопками карточки. -->
    <Style x:Key="PlainButtonM" TargetType="Button" BasedOn="{StaticResource FilledButtonM}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
        <Setter Property="FontFamily" Value="{OnPlatform Android=InterRegular}" />
        <Setter Property="FontAttributes" Value="None" />
    </Style>

    <!-- Размер S (28): «Исправить» в строке «Надёжности»; область нажатия до 44 добирает HitTarget. -->
    <Style x:Key="TintedButtonS" TargetType="Button" BasedOn="{StaticResource TintedButtonM}">
        <Setter Property="HeightRequest" Value="{StaticResource SizeButtonS}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="{OnPlatform Android=-0.0962, Default=0}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Стеклянная кнопка панели (✕, ✓, «+», «назад»): круг 44. На Android и при «Понижении прозрачности» — заливка без размытия.
         Внутри — Image 20–22 с design:IconTint.Color="{DynamicResource Label}"; главная (✓) — стиль GlassButtonProminent. -->
    <Style x:Key="GlassButton" TargetType="Border">
        <Setter Property="WidthRequest" Value="{StaticResource SizeGlassButton}" />
        <Setter Property="HeightRequest" Value="{StaticResource SizeGlassButton}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource GlassFill}" />
        <Setter Property="Stroke" Value="{DynamicResource GlassEdge}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource HairlineWidth}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="GlassButtonProminent" TargetType="Border" BasedOn="{StaticResource GlassButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!-- Кнопка-переключатель вне списка (фильтры, быстрые варианты времени): капсула 34; «вкл» — ToggleChipOn. -->
    <Style x:Key="ToggleChip" TargetType="Border">
        <Setter Property="HeightRequest" Value="{StaticResource SizeButtonM}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource TertiarySystemFill}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 17" />
    </Style>

    <Style x:Key="ToggleChipOn" TargetType="Border" BasedOn="{StaticResource ToggleChip}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
    </Style>

    <Style x:Key="ToggleChipText" TargetType="Label" BasedOn="{StaticResource TextSubheadlineEmphasized}">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Контролы ===== -->

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Success}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Knob}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Tint}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource SystemFill}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Knob}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Tint}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource SecondaryLabel}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Tint}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Label}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PlaceholderText}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="{OnPlatform Android=InterRegular}" />
        <Setter Property="CharacterSpacing" Value="{OnPlatform Android=-0.4167, Default=0}" />
        <Setter Property="design:Typography.Style" Value="Body" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
        <!-- Поле по центру строки, на одной линии с подписью. Растянуть его на всю строку нельзя: EditText центрирует
             текст по измеренной высоте, а MAUI растягивает поле без перемера, и текст уходит к верху. Высота 44 —
             зона касания; она входит в измерение, поэтому текст внутри тоже по центру. -->
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeHit}" />
    </Style>

</ResourceDictionary>
