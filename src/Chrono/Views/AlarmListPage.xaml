<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.AlarmListPage"
             x:DataType="vm:AlarmListViewModel">

    <!-- DESIGN.md §4.3. Шапка LargeTitleHeader лежит поверх прокрутки; первым элементом прокручиваемого содержимого стоит отступ высотой шапки.
         Список — одна секция (Section) строк в ScrollView: так он остаётся одной карточкой с общим скруглением. Будильников немного, виртуализация не нужна. -->
    <Grid SafeAreaEdges="Container">

        <ScrollView x:Name="Scroller" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout>
                <ContentView HeightRequest="{Binding HeaderHeight, Source={x:Reference Header}, x:DataType=controls:LargeTitleHeader}" />

                <VerticalStackLayout Padding="16,16,16,24" Spacing="{StaticResource Space6}">

                    <!-- Подсказка о надёжности (DESIGN.md §3 › Подсказка): символ warning, заголовок, первая проблема, действие; ✕ скрывает до следующей проблемы. -->
                    <!-- Поля карточки — у внутренней сетки, а не у Border: ✕ с отрицательным отступом остаётся в её границах,
                         иначе касания за границей родителя до ✕ не доходят. -->
                    <Border Style="{StaticResource Tip}" Padding="0" IsVisible="{Binding IsWarningVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,12">
                            <Image Source="icon_warning.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Start"
                                   design:IconTint.Color="{DynamicResource Warning}" />

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{x:Static res:AppResources.TipLateTitle}" Style="{StaticResource TextHeadline}" TextColor="{DynamicResource Label}" />
                                <Label Text="{Binding WarningText}" Style="{StaticResource RowSubtitle}" />
                                <Label Text="{x:Static res:AppResources.TipLateAction}" Style="{StaticResource TextSubheadlineEmphasized}"
                                       TextColor="{DynamicResource Tint}" HorizontalOptions="Start" VerticalTextAlignment="Center"
                                       MinimumHeightRequest="{StaticResource SizeHit}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenReliabilityCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Область нажатия 44 × 44 уходит в поля карточки: символ стоит у её угла, а не в середине отступа. -->
                            <Grid Grid.Column="2" WidthRequest="{StaticResource SizeHit}" HeightRequest="{StaticResource SizeHit}"
                                  Margin="0,-12,-16,0" VerticalOptions="Start"
                                  SemanticProperties.Description="{x:Static res:AppResources.TipDismiss}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DismissWarningCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Source="icon_close.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"
                                       design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Одна секция строк. Свайп влево открывает «Удалить»; в режиме «Изменить» слева красный «−» делает то же. -->
                    <Border Style="{StaticResource Section}" IsVisible="{Binding HasAlarms}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alarms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlarmItem">
                                    <VerticalStackLayout>
                                        <SwipeView>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <!-- SwipeItemView, а не SwipeItem: корзину перекрашивает IconTint, у SwipeItem.IconImageSource такой возможности нет. -->
                                                    <SwipeItemView Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:AlarmListViewModel}}, x:DataType=vm:AlarmListViewModel}"
                                                                   CommandParameter="{Binding .}">
                                                        <Grid WidthRequest="88" BackgroundColor="{DynamicResource Destructive}">
                                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                                                <Image Source="icon_trash.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"
                                                                       design:IconTint.Color="{DynamicResource OnTint}" />
                                                                <Label Text="{x:Static res:AppResources.Delete}" Style="{StaticResource TextFootnoteEmphasized}"
                                                                       TextColor="{DynamicResource OnTint}" HorizontalTextAlignment="Center" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </SwipeItemView>
                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- Фон строки непрозрачный: под ним при свайпе лежит красная кнопка. -->
                                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0"
                                                  BackgroundColor="{DynamicResource SecondarySystemGroupedBackground}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:AlarmListViewModel}}, x:DataType=vm:AlarmListViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>

                                                <!-- Красный круг «−» режима «Изменить»; область нажатия 44 × 44 заходит в поле строки. -->
                                                <Grid WidthRequest="{StaticResource SizeHit}" HeightRequest="{StaticResource SizeHit}" Margin="-10,0,2,0" VerticalOptions="Center"
                                                      IsVisible="{Binding IsEditing, Source={RelativeSource AncestorType={x:Type vm:AlarmListViewModel}}, x:DataType=vm:AlarmListViewModel}"
                                                      SemanticProperties.Description="{x:Static res:AppResources.Delete}">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnMinusTapped" />
                                                    </Grid.GestureRecognizers>
                                                    <Border WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                            BackgroundColor="{DynamicResource Destructive}" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Image Source="icon_minus.png" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"
                                                               design:IconTint.Color="{DynamicResource OnTint}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Выключенный будильник: время и подпись — SecondaryLabel; у включённого подпись — Label. -->
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding TimeText}" Style="{StaticResource TimeRow}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding Details}" Style="{StaticResource RowSubtitle}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="TextColor" Value="{DynamicResource Label}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </VerticalStackLayout>

                                                <Switch Grid.Column="2" IsToggled="{Binding IsEnabled}" VerticalOptions="Center"
                                                        SemanticProperties.Description="{Binding TimeText}" />
                                            </Grid>
                                        </SwipeView>

                                        <BoxView Style="{StaticResource RowSeparator}" IsVisible="{Binding ShowSeparator}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Пусто: по центру экрана. -->
        <Label Text="{x:Static res:AppResources.EmptyList}" Style="{StaticResource TextCallout}" TextColor="{DynamicResource SecondaryLabel}"
               HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" Margin="32,0" InputTransparent="True"
               IsVisible="{Binding IsEmpty}" />

        <controls:LargeTitleHeader x:Name="Header" VerticalOptions="Start" Title="{x:Static res:AppResources.Tab_Alarms}"
                                   Subtitle="{Binding NextAlarmText}" ScrollView="{x:Reference Scroller}">
            <controls:LargeTitleHeader.LeadingContent>
                <controls:GlassIconButton Text="{Binding EditText}" Description="{Binding EditText}" IsVisible="{Binding HasAlarms}"
                                          Command="{Binding ToggleEditCommand}" />
            </controls:LargeTitleHeader.LeadingContent>
            <controls:LargeTitleHeader.TrailingContent>
                <controls:GlassIconButton Source="icon_plus.png" Description="{x:Static res:AppResources.NewAlarm}"
                                          Command="{Binding AddCommand}" />
            </controls:LargeTitleHeader.TrailingContent>
        </controls:LargeTitleHeader>
    </Grid>
</ContentPage>
