<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             x:Class="Chrono.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel">

    <ContentPage.Resources>
        <!-- День недели над числом: Caption 1 Semibold, SecondaryLabel (DESIGN.md §4.9). -->
        <Style x:Key="WeekdayName" TargetType="Label" BasedOn="{StaticResource TextCaption1Emphasized}">
            <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <!-- DESIGN.md §4.9. Шапка лежит поверх прокрутки: неделя и лента прокручиваются вместе, Large Title сворачивается в inline-заголовок.
         Первым элементом содержимого — отступ высотой в шапку. -->
    <Grid SafeAreaEdges="Container">
        <!-- Панель: «Сегодня» слева, «+» справа (на прошедшем дне неактивна: команда не выполняется, кнопка бледная). Объявлена первой, чтобы на неё
             можно было сослаться из отступа ниже, и поднята над прокруткой через ZIndex; прокрутку страница передаёт шапке в коде. -->
        <controls:LargeTitleHeader x:Name="Header" VerticalOptions="Start" ZIndex="1"
                                   Title="{x:Static res:AppResources.Tab_Schedule}" Subtitle="{Binding Subtitle}" SubtitleInBar="True">
            <controls:LargeTitleHeader.LeadingContent>
                <controls:GlassIconButton Text="{x:Static res:AppResources.Today}" Command="{Binding TodayCommand}" />
            </controls:LargeTitleHeader.LeadingContent>
            <controls:LargeTitleHeader.TrailingContent>
                <controls:GlassIconButton Source="icon_plus.png" IsAccent="True" Description="{x:Static res:AppResources.NewAlarm}"
                                          Command="{Binding AddCommand}">
                    <controls:GlassIconButton.Triggers>
                        <DataTrigger TargetType="controls:GlassIconButton" Binding="{Binding IsAddEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </controls:GlassIconButton.Triggers>
                </controls:GlassIconButton>
            </controls:LargeTitleHeader.TrailingContent>
        </controls:LargeTitleHeader>

        <ScrollView x:Name="Scroll" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,0,0,24">
                <Grid HeightRequest="{Binding HeaderHeight, Source={x:Reference Header}, x:DataType=controls:LargeTitleHeader, Mode=OneWay}">
                    <!-- Смена недели для TalkBack / VoiceOver: свайп по дням недоступен экранному диктору, и сюда кладутся две настоящие кнопки
                         с теми же командами, что у свайпов. Размер 1 × 1, без текста и заливки, под шапкой (она выше по ZIndex) — зрячий вид экрана
                         не меняется, а в дереве доступности кнопки есть и идут перед днями. -->
                    <Button Style="{StaticResource PlainButton}" WidthRequest="1" HeightRequest="1" Padding="0" HorizontalOptions="Start" VerticalOptions="End"
                            SemanticProperties.Description="{x:Static res:AppResources.PrevWeek}" Command="{Binding PrevWeekCommand}" />
                    <Button Style="{StaticResource PlainButton}" WidthRequest="1" HeightRequest="1" Padding="0" HorizontalOptions="Start" VerticalOptions="End"
                            Margin="3,0,0,0" SemanticProperties.Description="{x:Static res:AppResources.NextWeek}" Command="{Binding NextWeekCommand}" />
                </Grid>

                <!-- Неделя с понедельника: семь колонок поровну. Касание выбирает день; свайп — на каждой колонке:
                     распознаватель на родителе перекрывался бы нажатием дочерних. -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="8,8,8,0"
                      BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayCell">
                            <VerticalStackLayout Grid.Column="{Binding Column}" Spacing="2"
                                                 SemanticProperties.Description="{Binding AccessibleText}">
                                <VerticalStackLayout.Resources>
                                    <!-- Круг 40: выбранный день — Label, выбранное «сегодня» — Tint. Базовые значения — в стиле, не локально:
                                         локальное значение перекрыло бы триггер. -->
                                    <Style x:Key="DayCircle" TargetType="Border">
                                        <Setter Property="WidthRequest" Value="40" />
                                        <Setter Property="HeightRequest" Value="40" />
                                        <Setter Property="HorizontalOptions" Value="Center" />
                                        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource Label}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelectedToday}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- Число: Title 3; сегодня — Semibold цветом Tint. Выбранный день — число на круге. -->
                                    <Style x:Key="DayNumber" TargetType="Label" BasedOn="{StaticResource TextTitle3}">
                                        <Setter Property="TextColor" Value="{DynamicResource Label}" />
                                        <Setter Property="HorizontalOptions" Value="Center" />
                                        <Setter Property="VerticalOptions" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource SystemBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="DayNumberToday" TargetType="Label" BasedOn="{StaticResource TextTitle3Emphasized}">
                                        <Setter Property="TextColor" Value="{DynamicResource Tint}" />
                                        <Setter Property="HorizontalOptions" Value="Center" />
                                        <Setter Property="VerticalOptions" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource OnTint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </VerticalStackLayout.Resources>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectDayCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                        CommandParameter="{Binding Date}" />
                                    <SwipeGestureRecognizer Direction="Left"
                                        Command="{Binding NextWeekCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}" />
                                    <SwipeGestureRecognizer Direction="Right"
                                        Command="{Binding PrevWeekCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Label}" Style="{StaticResource WeekdayName}" />
                                <Border Style="{StaticResource DayCircle}">
                                    <Grid>
                                        <Label Text="{Binding Number}" Style="{StaticResource DayNumber}" IsVisible="{Binding IsNotToday}" />
                                        <Label Text="{Binding Number}" Style="{StaticResource DayNumberToday}" IsVisible="{Binding IsToday}" />
                                    </Grid>
                                </Border>
                                <!-- Точки: не больше трёх по числу записей дня. -->
                                <HorizontalStackLayout HeightRequest="6" Spacing="4" HorizontalOptions="Center"
                                                       BindableLayout.ItemsSource="{Binding Dots}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{DynamicResource TertiaryLabel}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>

                <!-- Лента: одна секция. Слева время, значок 18 на круге цвета категории, название и подробности, справа отметка «сделано». -->
                <Border Style="{StaticResource Section}" Margin="16,16,16,0" IsVisible="{Binding HasEntries}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayEntryItem">
                                <VerticalStackLayout>
                                    <VerticalStackLayout.Resources>
                                        <!-- Базовые значения — в стилях с триггерами внутри: локальное значение перекрыло бы триггер.
                                             Текущая запись (время Tint Semibold, название bodyEmphasized) — отдельные подписи с IsVisible:
                                             начертание стилем не переключить. -->
                                        <Style x:Key="EntryTime" TargetType="Label" BasedOn="{StaticResource TextSubheadline}">
                                            <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
                                            <Setter Property="VerticalOptions" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource TertiaryLabel}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="EntryTimeNow" TargetType="Label" BasedOn="{StaticResource TextSubheadlineEmphasized}">
                                            <Setter Property="TextColor" Value="{DynamicResource Tint}" />
                                            <Setter Property="VerticalOptions" Value="Center" />
                                        </Style>
                                        <Style x:Key="EntryTitle" TargetType="Label" BasedOn="{StaticResource RowTitle}">
                                            <!-- Выполненная запись серая, как на эталоне; выключенная — ещё бледнее: её триггер последний и перекрывает. -->
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource TertiaryLabel}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="EntryTitleNow" TargetType="Label" BasedOn="{StaticResource TextBodyEmphasized}">
                                            <Setter Property="TextColor" Value="{DynamicResource Label}" />
                                            <Setter Property="VerticalOptions" Value="Center" />
                                        </Style>
                                    </VerticalStackLayout.Resources>

                                    <BoxView Style="{StaticResource RowSeparator}" IsVisible="{Binding ShowSeparator}" />
                                    <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,32,*,Auto" Padding="16,8,6,8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label Text="{Binding TimeText}" Style="{StaticResource EntryTime}" IsVisible="{Binding IsNotCurrent}" />
                                        <Label Text="{Binding TimeText}" Style="{StaticResource EntryTimeNow}" IsVisible="{Binding IsCurrent}" />

                                        <!-- Значок 18 белым на круге 32 цвета категории (цвет — роль Cat1…Cat6, следует теме). -->
                                        <Border Grid.Column="1" WidthRequest="32" HeightRequest="32" VerticalOptions="Center"
                                                StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                                design:CategoryColor.Index="{Binding CategoryIndex}">
                                            <Image Source="{Binding IconImage}" WidthRequest="18" HeightRequest="18"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   design:IconTint.Color="{DynamicResource OnTint}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource EntryTitle}" IsVisible="{Binding IsNotCurrent}" />
                                            <Label Text="{Binding Title}" Style="{StaticResource EntryTitleNow}" IsVisible="{Binding IsCurrent}"
                                                   SemanticProperties.Description="{Binding TitleDescription}" />
                                            <Label Text="{Binding RangeText}" Style="{StaticResource Footnote}" IsVisible="{Binding HasRange}" />
                                            <!-- Полоса прогресса текущей записи: трек SystemFill 4, заполнение Tint растягивается от левого края. -->
                                            <Border IsVisible="{Binding IsCurrent}" HeightRequest="{StaticResource SizeProgress}" Margin="0,6,12,0"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 2" BackgroundColor="{DynamicResource SystemFill}">
                                                <BoxView Color="{DynamicResource Tint}" AnchorX="0" ScaleX="{Binding Progress}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <controls:DoneToggle Grid.Column="3" VerticalOptions="Center"
                                            IsDone="{Binding IsDone}" Description="{Binding DoneDescription}"
                                            Command="{Binding ToggleDoneCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static res:AppResources.ScheduleEmpty}" Style="{StaticResource TextSubheadline}"
                       TextColor="{DynamicResource SecondaryLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       IsVisible="{Binding IsEmpty}" Margin="24,48" />

                <!-- Низ прокрутки: содержимое можно поднять выше плавающего нижнего меню Android (на iOS элемента нет). -->
                <ContentView Style="{StaticResource TabBarClearance}" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:FloatingTabBar Current="schedule" />
    </Grid>
</ContentPage>
