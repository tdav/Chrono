<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,12,20,0" SafeAreaEdges="Container">

        <!-- Заголовок: «20 октября» и год золотыми чернилами; справа стрелки недели (свайп по строке дней ненадёжен). -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label Style="{StaticResource ScreenTitle}" Padding="0,6,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding TitleDay}" />
                        <Span Text="{Binding TitleYear}" TextColor="{StaticResource GoldInk}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Border Grid.Column="1" Style="{StaticResource IconWell}" SemanticProperties.Description="{x:Static res:AppResources.PrevWeek}">
                <Image Source="icon_back.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PrevWeekCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource IconWell}" SemanticProperties.Description="{x:Static res:AppResources.NextWeek}">
                <Image Source="icon_next.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextWeekCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- Неделя с понедельника: семь колонок поровну; снизу 50 — отступ от точек до списка (просьба пользователя). Свайп — на каждой колонке: распознаватель на родителе перекрывался нажатием дочерних. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,14,0,50"
              BindableLayout.ItemsSource="{Binding Days}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:DayCell">
                    <VerticalStackLayout Grid.Column="{Binding Column}" Spacing="3"
                                         SemanticProperties.Description="{Binding AccessibleText}">
                        <VerticalStackLayout.Resources>
                            <!-- Кружок 40: выбранный — металл, сегодня — золотое кольцо 1,5. Базовые значения — в стиле, не локально. -->
                            <Style x:Key="DayCircle" TargetType="Border">
                                <Setter Property="WidthRequest" Value="40" />
                                <Setter Property="HeightRequest" Value="40" />
                                <Setter Property="HorizontalOptions" Value="Center" />
                                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Stroke" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource MetalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </VerticalStackLayout.Resources>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectDayCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                CommandParameter="{Binding Date}" />
                            <SwipeGestureRecognizer Direction="Left"
                                Command="{Binding NextWeekCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}" />
                            <SwipeGestureRecognizer Direction="Right"
                                Command="{Binding PrevWeekCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding Label}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsWeekendInk}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource GoldInk}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border Style="{StaticResource DayCircle}">
                            <Label Text="{Binding Number}" FontFamily="ManropeBold" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWeekendInk}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource GoldInk}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource OnMetal}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <!-- Точки: не больше пяти по числу записей дня. -->
                        <HorizontalStackLayout HeightRequest="5" Spacing="3" HorizontalOptions="Center"
                                               BindableLayout.ItemsSource="{Binding Dots}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="{StaticResource Hairline}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Entries}" SelectionMode="None" VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DayEntryItem">
                    <Grid ColumnDefinitions="46,42,*,44" ColumnSpacing="10" Margin="0,0,0,14">
                        <Grid.Resources>
                            <!-- Базовые значения — в стилях с триггерами внутри, чтобы локальное значение не перекрывало триггер. -->
                            <Style x:Key="EntryTime" TargetType="Label" BasedOn="{StaticResource Footnote}">
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Hairline}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="EntryTitle" TargetType="Label" BasedOn="{StaticResource RowValue}">
                                <Setter Property="TextColor" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Hairline}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="IconCapsule" TargetType="Border">
                                <Setter Property="WidthRequest" Value="42" />
                                <Setter Property="VerticalOptions" Value="Start" />
                                <Setter Property="StrokeShape" Value="RoundRectangle 21" />
                                <Setter Property="StrokeThickness" Value="1" />
                                <Setter Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Stroke" Value="{StaticResource Hairline}" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource MetalBrush}" />
                                        <Setter Property="Stroke" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="DoneCircle" TargetType="Border">
                                <Setter Property="WidthRequest" Value="22" />
                                <Setter Property="HeightRequest" Value="22" />
                                <Setter Property="HorizontalOptions" Value="Center" />
                                <Setter Property="VerticalOptions" Value="Center" />
                                <Setter Property="StrokeShape" Value="RoundRectangle 11" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                                <Setter Property="Stroke" Value="{StaticResource Hairline}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Gold}" />
                                        <Setter Property="Stroke" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label Text="{Binding TimeText}" Style="{StaticResource EntryTime}" VerticalOptions="Start" Margin="0,13,0,0" />

                        <!-- Иконка: круг 42; у текущего дела — капсула на металле, иконка в круге 30 у верхнего края. -->
                        <Border Grid.Column="1" Style="{StaticResource IconCapsule}" HeightRequest="{Binding CapsuleHeight}">
                            <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" StrokeThickness="0"
                                    Background="{StaticResource Surface}" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,5,0,0">
                                <Image Source="{Binding IconImage}" WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Border>

                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Start" Margin="0,4,0,0" Spacing="1">
                            <Label Text="{Binding RangeText}" Style="{StaticResource Footnote}" IsVisible="{Binding HasRange}" />
                            <Label Text="{Binding Title}" Style="{StaticResource EntryTitle}" />
                        </VerticalStackLayout>

                        <!-- Отметка «сделано»: кружок 22 в области нажатия 44. -->
                        <Grid Grid.Column="3" WidthRequest="44" HeightRequest="44" VerticalOptions="Start" HorizontalOptions="End"
                              SemanticProperties.Description="{Binding DoneDescription}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleDoneCommand, Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, x:DataType=vm:ScheduleViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource DoneCircle}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="96" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <Label Grid.Row="2" Text="{x:Static res:AppResources.ScheduleEmpty}" Style="{StaticResource Muted}" FontSize="14"
               IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Start" Margin="24,48" />

        <!-- Плавающая кнопка «+»; на прошедшем дне неактивна (CanExecute команды) и бледная. -->
        <Border Grid.Row="2" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30"
                Background="{StaticResource MetalBrush}" Stroke="{StaticResource Gold}" StrokeThickness="1"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,24"
                SemanticProperties.Description="{x:Static res:AppResources.NewAlarm}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsAddEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Border.Triggers>
            <Border.Shadow>
                <Shadow Brush="#2E3136" Offset="0,10" Radius="22" Opacity="0.28" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddCommand}" />
            </Border.GestureRecognizers>
            <Image Source="icon_plus.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
