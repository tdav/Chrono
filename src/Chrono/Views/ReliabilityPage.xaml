<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             Shell.TabBarIsVisible="False"
             x:Class="Chrono.Views.ReliabilityPage"
             x:DataType="vm:ReliabilityViewModel">

    <ContentPage.Resources>
        <!-- Пояснение под панелью: callout, SecondaryLabel; поля 16 — на одной линии с названиями строк. -->
        <Style x:Key="Intro" TargetType="Label" BasedOn="{StaticResource TextCallout}">
            <Setter Property="TextColor" Value="{DynamicResource SecondaryLabel}" />
            <Setter Property="Margin" Value="16,8,16,16" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="Container">

        <!-- Панель вложенного экрана (DESIGN.md §4.6): «назад» слева, inline-заголовок по центру. «Назад» снимает страницу со стека
             вкладки, с которой её открыли, — из «Настроек» это «Настройки». -->
        <controls:NavBar Title="{x:Static res:AppResources.ReliabilityTitle}" BackCommand="{Binding CloseCommand}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,0,16,24" Spacing="0">
                <Label Text="{x:Static res:AppResources.ReliabilityIntro}" Style="{StaticResource Intro}" />

                <Border Style="{StaticResource Section}">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReliabilityRow">
                                <VerticalStackLayout Spacing="0">
                                    <!-- Статус — значок и слова под названием; «Исправить» только у проблемного пункта. Высота растёт с переносом текста. -->
                                    <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                                        <Grid>
                                            <controls:StatusIcon Fill="{DynamicResource Success}" Source="icon_check.png" IsVisible="{Binding Ok}" />
                                            <controls:StatusIcon Fill="{DynamicResource Warning}" Source="icon_alert.png" IsVisible="{Binding NeedsFix}" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource RowSubtitle}" />
                                        </VerticalStackLayout>
                                        <!-- Капсула 28; область нажатия 44 даёт HitTarget. -->
                                        <controls:HitTarget Grid.Column="2" VerticalOptions="Center" IsVisible="{Binding NeedsFix}">
                                            <Button Text="{x:Static res:AppResources.Fix}" Style="{StaticResource TintedButtonS}" VerticalOptions="Center"
                                                    SemanticProperties.Description="{Binding Title, StringFormat={x:Static res:AppResources.FixDescription}}"
                                                    Command="{Binding FixCommand, Source={RelativeSource AncestorType={x:Type vm:ReliabilityViewModel}}, x:DataType=vm:ReliabilityViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </controls:HitTarget>
                                    </Grid>
                                    <BoxView Style="{StaticResource IconRowSeparator}" IsVisible="{Binding HasSeparator}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static res:AppResources.ReliabilityFooter}" Style="{StaticResource SectionFooter}" />
                <Label Text="{x:Static res:AppResources.OemHint}" Style="{StaticResource SectionFooter}" IsVisible="{Binding IsAndroid}" />
                <Label Text="{x:Static res:AppResources.SilentHint}" Style="{StaticResource SectionFooter}" IsVisible="{Binding IsIos}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
