<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.Sheets.TimeWheelSheet"
             x:DataType="vm:TimeSheetModel">
    <ContentView.Resources>
        <!-- ToggleChip с полями 8: на телефоне шириной 360 колонка из четырёх — 72, а «Сейчас» с полями 14 в неё не помещается. -->
        <Style x:Key="QuickChip" TargetType="Border" BasedOn="{StaticResource ToggleChip}">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>
    <!-- Время (DESIGN.md §3.2): два барабана и «:», под ними быстрые варианты и сноска «Сработает … — через …».
         Кнопок «Отмена» и «Ок» нет — ✓ и ✕ в панели шторки. -->
    <VerticalStackLayout Spacing="{StaticResource Space3}">
        <!-- Полоса выбора одна на оба барабана и двоеточие: рисуется под ними, барабаны прозрачные. -->
        <Grid HeightRequest="{StaticResource SizeWheel}" ColumnDefinitions="*,90,Auto,90,*">
            <Border Grid.ColumnSpan="5" HeightRequest="{StaticResource SizeWheelRow}" VerticalOptions="Center" InputTransparent="True"
                    BackgroundColor="{DynamicResource TertiarySystemFill}" StrokeThickness="0" StrokeShape="RoundRectangle 8" />

            <controls:WheelPicker Grid.Column="1" Count="24" Value="{Binding Hour}" />

            <!-- Двоеточие Inter стоит ниже середины цифр; на Android поднимается на 2 pt. -->
            <Label Grid.Column="2" Text=":" Style="{StaticResource TextTitle2}" TextColor="{DynamicResource Label}"
                   HorizontalOptions="Center" VerticalOptions="Center" TranslationY="{OnPlatform Android=-2, Default=0}" />

            <controls:WheelPicker Grid.Column="3" Count="60" Value="{Binding Minute}" />
        </Grid>

        <!-- Быстрые варианты — кнопки-переключатели: «вкл» тот, что совпал с барабанами. Капсула 34, область нажатия 44. -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource Space2}">
            <Grid HeightRequest="{StaticResource SizeHit}" BackgroundColor="Transparent">
                <Border Style="{StaticResource QuickChip}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding QuickTimes[0].IsOn}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding QuickTimes[0].Label}" Style="{StaticResource ToggleChipText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding QuickTimes[0].IsOn}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource OnTint}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTick" Command="{Binding QuickCommand}" CommandParameter="{Binding QuickTimes[0]}" />
                </Grid.GestureRecognizers>
            </Grid>

            <Grid Grid.Column="1" HeightRequest="{StaticResource SizeHit}" BackgroundColor="Transparent">
                <Border Style="{StaticResource QuickChip}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding QuickTimes[1].IsOn}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding QuickTimes[1].Label}" Style="{StaticResource ToggleChipText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding QuickTimes[1].IsOn}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource OnTint}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTick" Command="{Binding QuickCommand}" CommandParameter="{Binding QuickTimes[1]}" />
                </Grid.GestureRecognizers>
            </Grid>

            <Grid Grid.Column="2" HeightRequest="{StaticResource SizeHit}" BackgroundColor="Transparent">
                <Border Style="{StaticResource QuickChip}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding QuickTimes[2].IsOn}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Tint}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding QuickTimes[2].Label}" Style="{StaticResource ToggleChipText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding QuickTimes[2].IsOn}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource OnTint}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTick" Command="{Binding QuickCommand}" CommandParameter="{Binding QuickTimes[2]}" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- «Сейчас» — действие, а не состояние: «вкл» не бывает. -->
            <Grid Grid.Column="3" HeightRequest="{StaticResource SizeHit}" BackgroundColor="Transparent">
                <Border Style="{StaticResource QuickChip}">
                    <Label Text="{x:Static res:AppResources.Now}" Style="{StaticResource ToggleChipText}" />
                </Border>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTick" Command="{Binding NowCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- Сноска: SectionFooter рассчитан на секцию с полями 16 от края экрана, а шторка уже даёт их своим отступом.
             Высота — не меньше двух строк footnote (2 × 18): фраза то переносится, то нет, а шторка прижата книзу —
             без запаса её верх и барабан прыгали бы под пальцем.
             ponytail: запас на базовый размер шрифта; при крупном системном шрифте прыжок возможен — тогда считать от LineHeight. -->
        <Label Text="{Binding Footnote}" Style="{StaticResource SectionFooter}" Margin="0" HorizontalTextAlignment="Center"
               MinimumHeightRequest="36" />
    </VerticalStackLayout>
</ContentView>
