<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:sheets="clr-namespace:Chrono.Views.Sheets"
             x:Class="Chrono.Views.Sheets.IconSheet"
             x:DataType="vm:OptionsSheetModel">

    <ContentView.Resources>
        <sheets:IconImageConverter x:Key="IconImage" />
    </ContentView.Resources>

    <VerticalStackLayout Spacing="16">

        <!-- Сетка 5 колонок × 10 рядов: ячейка занимает 20% ширины (Basis), кружок 56 по центру ячейки, поэтому колонок ровно 5 при любой ширине экрана. Сетка в ScrollView высотой не больше 350 (ряд — около 78, пятый ряд виден наполовину — намёк на прокрутку): панель шторки прижата к низу страницы, и без ограничения 50 иконок вытолкнули бы «Отмену» и «OK» за экран; кнопки лежат вне ScrollView и всегда видны. Иконки тёмные, поэтому у выбранной металл идёт кольцом вокруг светлого круга, а не заливкой под иконкой. -->
        <ScrollView MaximumHeightRequest="350">
        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Options}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceOption">
                    <Grid FlexLayout.Basis="20%" Margin="0,0,0,12">
                        <Border WidthRequest="56" HeightRequest="56" Padding="5" HorizontalOptions="Center"
                                StrokeThickness="0" StrokeShape="RoundRectangle 28"
                                Background="{StaticResource Surface2}"
                                SemanticProperties.Description="{Binding Name}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource MetalBrush}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OptionsSheetModel}}, Path=SelectCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 23" Background="{StaticResource Surface2}">
                                <Image Source="{Binding Id, Converter={StaticResource IconImage}}"
                                       WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Border>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
