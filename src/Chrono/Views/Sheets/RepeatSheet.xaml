<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             x:Class="Chrono.Views.Sheets.RepeatSheet"
             x:DataType="vm:RepeatSheetModel">

    <!-- Вид повтора (DESIGN.md §3.4): список выбора и, при «По дням недели», секция дней. Самостоятельный View: кнопок «Ок» и «Отмена» нет —
         ✓ и ✕ в панели шторки; ✓ неактивна, пока дней нет (CanConfirm модели). -->
    <VerticalStackLayout Spacing="{StaticResource Space6}">

        <!-- Варианты повтора: галочка Tint справа у выбранного, фон строки не меняется. -->
        <Border Style="{StaticResource SheetSection}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoiceOption">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                <Image Grid.Column="1" Source="icon_check.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"
                                       design:IconTint.Color="{DynamicResource Tint}" IsVisible="{Binding IsSelected}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RepeatSheetModel}}, Path=SelectCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView Style="{StaticResource RowSeparator}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsLast}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <!-- Дни недели: видны только при «По дням недели». Под кругами — итог («Пн, Ср, Пт») или, если дней нет, ошибка. -->
        <VerticalStackLayout IsVisible="{Binding IsDaysVisible}">
            <Label Text="{x:Static res:AppResources.RepeatDays}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SheetSection}" Padding="8">
                <controls:DayToggles Days="{Binding Days}" ToggleCommand="{Binding ToggleDayCommand}" />
            </Border>
            <Label Text="{Binding DaysSummary}" Style="{StaticResource SectionFooter}" IsVisible="{Binding HasDays}" />
            <Label Text="{x:Static res:AppResources.RepeatPickDay}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsDaysEmpty}" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
