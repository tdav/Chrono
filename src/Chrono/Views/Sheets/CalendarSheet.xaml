<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.Sheets.CalendarSheet"
             x:DataType="vm:CalendarSheetModel">

    <VerticalStackLayout Spacing="16">
        <!-- Навигация по месяцам. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Style="{StaticResource IconWell}" SemanticProperties.Description="{x:Static res:AppResources.PrevMonth}">
                <Image Source="icon_back.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PrevMonthCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="{Binding MonthTitle}" FontFamily="ManropeBold" FontSize="16"
                   TextColor="{StaticResource Text}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border Grid.Column="2" Style="{StaticResource IconWell}" SemanticProperties.Description="{x:Static res:AppResources.NextMonth}">
                <Image Source="icon_next.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- Заголовки дней с понедельника; Сб и Вс — золотые. -->
        <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="28">
            <Label Grid.Column="0" Text="{Binding WeekDayNames[0]}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding WeekDayNames[1]}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding WeekDayNames[2]}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="{Binding WeekDayNames[3]}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="4" Text="{Binding WeekDayNames[4]}" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="5" Text="{Binding WeekDayNames[5]}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource GoldInk}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="6" Text="{Binding WeekDayNames[6]}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource GoldInk}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Сетка дней: 6 строк × 44. Порядок триггеров важен — выбранный день побеждает. -->
        <CollectionView ItemsSource="{Binding Cells}" SelectionMode="None" HeightRequest="264">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDayItem">
                    <Grid HeightRequest="44">
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                Background="Transparent" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding Label}" FontFamily="ManropeSemiBold" FontSize="14" TextColor="{StaticResource Text}"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsWeekend}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource GoldInk}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDisabled}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Hairline}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="FontFamily" Value="ManropeExtraBold" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource OnMetal}" />
                                        <Setter Property="FontFamily" Value="ManropeExtraBold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Gold}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource MetalBrush}" />
                                    <Setter Property="StrokeThickness" Value="0" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarSheetModel}}, x:DataType=vm:CalendarSheetModel, Path=PickCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid ColumnDefinitions="*,*,1.3*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="{x:Static res:AppResources.Clear}" Style="{StaticResource AccentButton}" Command="{Binding ClearCommand}" IsVisible="{Binding IsClearVisible}" />
            <Button Grid.Column="1" Text="{x:Static res:AppResources.Today}" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" />
            <Button Grid.Column="2" Text="{x:Static res:AppResources.SheetOk}" Style="{StaticResource PrimaryButton}" Command="{Binding OkCommand}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
