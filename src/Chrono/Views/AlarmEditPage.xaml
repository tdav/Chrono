<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             x:Class="Chrono.Views.AlarmEditPage"
             x:DataType="vm:AlarmEditViewModel">

    <ContentPage.Resources>
        <!-- «Название, значение» для строк, которые нажимаются жестом: TalkBack читает строку целиком. -->
        <controls:RowDescriptionConverter x:Key="RowDescription" />
    </ContentPage.Resources>

    <!-- DESIGN.md §4.1: страница — шторка на большом детенте поверх экрана, откуда её открыли. Панель ✕ / «Будильник» или «Изменение» / ✓
         рисует сама шторка; ✓ неактивна, пока в форме ошибка (CanConfirm). Закрытие с правками (✕, свайп, «Назад») шторка подтверждает
         сама: «Не сохранять» / «Сохранить» / «Отменить». Повтор, оповещение, длительность и иконка открываются шагами внутри шторки
         (код страницы), звук — меню у строки, дата и окончание — календари в форме.
         Снизу All: шторка поднимается над клавиатурой (нужен WindowSoftInputModeAdjust=Resize в App.xaml). -->
    <Grid SafeAreaEdges="Container, Container, Container, All">

        <controls:BottomSheet x:Name="Sheet" Detent="Large" ShowGrabber="False" Title="{Binding Title}"
                              ConfirmCommand="{Binding SaveCommand}" CancelCommand="{Binding CancelCommand}"
                              CanConfirm="{Binding CanConfirm}" IsDirty="{Binding IsDirty}">
            <controls:BottomSheet.SheetTemplate>
                <DataTemplate x:DataType="vm:AlarmEditViewModel">
                    <Grid>
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout Padding="0,8,0,24" Spacing="{StaticResource Space6}">

                                <!-- Время (§3.2): барабан и сноска «Сработает … — через …». Полоса выбора одна на оба барабана и двоеточие:
                                     рисуется под ними, барабаны прозрачные. Высота сноски — не меньше двух строк footnote (2 × 18): фраза то
                                     переносится, то нет, и без запаса форма под барабаном прыгала бы вместе с ним. -->
                                <VerticalStackLayout Spacing="0">
                                    <Border Style="{StaticResource SheetSection}" Padding="8,0">
                                        <Grid HeightRequest="{StaticResource SizeWheel}" ColumnDefinitions="*,90,Auto,90,*">
                                            <Border Grid.ColumnSpan="5" HeightRequest="{StaticResource SizeWheelRow}" VerticalOptions="Center" InputTransparent="True"
                                                    BackgroundColor="{DynamicResource TertiarySystemFill}" StrokeThickness="0" StrokeShape="RoundRectangle 8" />

                                            <controls:WheelPicker Grid.Column="1" Count="24" Value="{Binding TimeSheet.Hour}" />

                                            <!-- Двоеточие Inter стоит ниже середины цифр; на Android поднимается на 2 pt. -->
                                            <Label Grid.Column="2" Text=":" Style="{StaticResource TextTitle2}" TextColor="{DynamicResource Label}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" TranslationY="{OnPlatform Android=-2, Default=0}" />

                                            <controls:WheelPicker Grid.Column="3" Count="60" Value="{Binding TimeSheet.Minute}" />
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding TimeSheet.Footnote}" Style="{StaticResource SectionFooter}" MinimumHeightRequest="36" />
                                </VerticalStackLayout>

                                <!-- Повтор, дата, окончание, название, иконка. Ошибки и подсказка — сноской под секцией. -->
                                <VerticalStackLayout Spacing="0">
                                    <Border Style="{StaticResource SheetSection}">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Style="{StaticResource Row}" BackgroundColor="Transparent" ColumnDefinitions="Auto,*,Auto"
                                                  SemanticProperties.Description="{Binding RepeatText, Converter={StaticResource RowDescription}, ConverterParameter={x:Static res:AppResources.RepeatHeader}}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRepeatTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{x:Static res:AppResources.RepeatHeader}" Style="{StaticResource RowTitle}" />
                                                <Label Grid.Column="1" Text="{Binding RepeatText}" Style="{StaticResource RowValue}" />
                                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                       design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                                            </Grid>

                                            <!-- Дата и окончание — чип в строке и календарь, раскрывающийся под ней (§3.3). У окончания пустое значение — «Не выбрано». -->
                                            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsDateRowVisible}">
                                                <BoxView Style="{StaticResource RowSeparator}" />
                                                <controls:InlineCalendar Title="{x:Static res:AppResources.RowDate}" Model="{Binding CalendarSheet}"
                                                                         IsExpanded="{Binding IsDateExpanded}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsEndsRowVisible}">
                                                <BoxView Style="{StaticResource RowSeparator}" />
                                                <controls:InlineCalendar Title="{x:Static res:AppResources.RowEnds}" Model="{Binding EndsSheet}"
                                                                         IsExpanded="{Binding IsEndsExpanded}" />
                                            </VerticalStackLayout>

                                            <BoxView Style="{StaticResource RowSeparator}" />
                                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                                                <Label Text="{x:Static res:AppResources.RowName}" Style="{StaticResource RowTitle}" />
                                                <Entry Grid.Column="1" Text="{Binding Label}" Placeholder="{x:Static res:AppResources.DefaultLabel}"
                                                       MaxLength="60" HorizontalTextAlignment="End" ReturnType="Done" Loaded="OnNameLoaded" />
                                            </Grid>

                                            <BoxView Style="{StaticResource RowSeparator}" />
                                            <Grid Style="{StaticResource Row}" BackgroundColor="Transparent" ColumnDefinitions="*,Auto,Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnIconTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{x:Static res:AppResources.RowIcon}" Style="{StaticResource RowTitle}" />
                                                <Border Grid.Column="1" WidthRequest="{StaticResource SizeRowIcon}" HeightRequest="{StaticResource SizeRowIcon}"
                                                        VerticalOptions="Center" StrokeShape="RoundRectangle 15" StrokeThickness="0"
                                                        BackgroundColor="{DynamicResource Tint}" AutomationProperties.IsInAccessibleTree="False">
                                                    <Image Source="{Binding IconImage}" WidthRequest="18" HeightRequest="18"
                                                           HorizontalOptions="Center" VerticalOptions="Center" design:IconTint.Color="{DynamicResource OnTint}" />
                                                </Border>
                                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                       design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Text="{x:Static res:AppResources.EndsPickHint}" Style="{StaticResource SectionFooter}" IsVisible="{Binding IsEndsMissing}" />
                                    <Label Text="{x:Static res:AppResources.RepeatPickDay}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsDaysMissing}" />
                                    <Label Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />
                                </VerticalStackLayout>

                                <!-- Сигнал: оповещение, звук (меню) и вибрация — только у звонящей записи, длительность. -->
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{x:Static res:AppResources.SignalHeader}" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
                                    <Border Style="{StaticResource SheetSection}">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Style="{StaticResource Row}" BackgroundColor="Transparent" ColumnDefinitions="Auto,*,Auto"
                                                  SemanticProperties.Description="{Binding AlertText, Converter={StaticResource RowDescription}, ConverterParameter={x:Static res:AppResources.RowAlert}}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAlertTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{x:Static res:AppResources.RowAlert}" Style="{StaticResource RowTitle}" />
                                                <Label Grid.Column="1" Text="{Binding AlertText}" Style="{StaticResource RowValue}" />
                                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                       design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                                            </Grid>

                                            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsSoundRowsVisible}">
                                                <BoxView Style="{StaticResource RowSeparator}" />
                                                <Grid Style="{StaticResource Row}" BackgroundColor="Transparent" ColumnDefinitions="Auto,*,Auto"
                                                      SemanticProperties.Description="{Binding SoundText, Converter={StaticResource RowDescription}, ConverterParameter={x:Static res:AppResources.Sound}}">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnSoundTapped" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Text="{x:Static res:AppResources.Sound}" Style="{StaticResource RowTitle}" />
                                                    <Label Grid.Column="1" Text="{Binding SoundText}" Style="{StaticResource RowValue}" />
                                                    <Image Grid.Column="2" Source="icon_chevron_updown.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                           design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                                                </Grid>
                                                <BoxView Style="{StaticResource RowSeparator}" />
                                                <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                                                    <Label Text="{x:Static res:AppResources.Vibration}" Style="{StaticResource RowTitle}" />
                                                    <Switch Grid.Column="1" IsToggled="{Binding VibrationEnabled}" VerticalOptions="Center" />
                                                </Grid>
                                            </VerticalStackLayout>

                                            <BoxView Style="{StaticResource RowSeparator}" />
                                            <Grid Style="{StaticResource Row}" BackgroundColor="Transparent" ColumnDefinitions="Auto,*,Auto"
                                                  SemanticProperties.Description="{Binding DurationText, Converter={StaticResource RowDescription}, ConverterParameter={x:Static res:AppResources.RowDuration}}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDurationTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{x:Static res:AppResources.RowDuration}" Style="{StaticResource RowTitle}" />
                                                <Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource RowValue}" />
                                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                                       design:IconTint.Color="{DynamicResource TertiaryLabel}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Text="{x:Static res:AppResources.SaveFootnote}" Style="{StaticResource SectionFooter}" />
                                </VerticalStackLayout>

                                <!-- Удаление — отдельной секцией внизу и только у существующей записи; подтверждение — диалог из этой строки. -->
                                <Border Style="{StaticResource SheetSection}" IsVisible="{Binding IsExisting}">
                                    <Grid Style="{StaticResource Row}" BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{x:Static res:AppResources.DeleteAlarm}" Style="{StaticResource DestructiveRowAction}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Меню звука лежит поверх формы, а не страницы: большая шторка уменьшает всё, что рядом с ней в корне страницы,
                             и якорь (строка «Звук») оказался бы не там, где рисуется меню. -->
                        <controls:PopupMenu Items="{Binding SoundSheet.Options}" SelectCommand="{Binding SoundSheet.SelectCommand}"
                                            Description="{x:Static res:AppResources.Sound}" Loaded="OnSoundMenuLoaded" />
                    </Grid>
                </DataTemplate>
            </controls:BottomSheet.SheetTemplate>
        </controls:BottomSheet>
    </Grid>
</ContentPage>
