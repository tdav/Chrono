<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:sheets="clr-namespace:Chrono.Views.Sheets"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             x:Class="Chrono.Views.AlarmEditPage"
             x:DataType="vm:AlarmEditViewModel">

    <!-- Снизу All: кнопки поднимаются над клавиатурой (нужен WindowSoftInputModeAdjust=Resize в App.xaml). -->
    <Grid SafeAreaEdges="Container, Container, Container, All">

        <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,16">

            <!-- Шапка: «назад» и название экрана. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,16">
                <Border Style="{StaticResource IconWell}" SemanticProperties.Description="{x:Static res:AppResources.Back}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Image Source="icon_back.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource ScreenTitle}" />
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="22">

                    <!-- Плашка: когда сработает и через сколько. -->
                    <Border StrokeShape="RoundRectangle 20" Background="{StaticResource MetalBrush}"
                            Stroke="{StaticResource GoldEdgeBrush}" StrokeThickness="1" Padding="20,20,20,18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding PlateTitle}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Gold}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding TimeText}" FontFamily="ManropeExtraBold" FontSize="64" TextColor="{StaticResource OnMetal}" />
                                <Label Grid.Column="1" Text="{Binding RelText}" FontFamily="ManropeSemiBold" FontSize="13"
                                       TextColor="{StaticResource OnMetal}" Opacity="0.7" VerticalOptions="End" Margin="0,0,0,12" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Повтор, время, дата: каждая строка открывает свою шторку. -->
                    <Border Style="{StaticResource RowGroup}">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRepeatCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RepeatHeader}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding RepeatText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTimeCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RowTime}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" IsVisible="{Binding IsDateRowVisible}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsDateRowVisible}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDateCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RowDate}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Название, иконка, длительность, оповещение; звук и вибрация — только у звонящей записи. -->
                    <Border Style="{StaticResource RowGroup}">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                                <Label Text="{x:Static res:AppResources.RowName}" Style="{StaticResource RowKey}" />
                                <Entry Grid.Column="1" Text="{Binding Label}" Placeholder="{x:Static res:AppResources.DefaultLabel}"
                                       MaxLength="60" HorizontalTextAlignment="End" VerticalOptions="Center"
                                       FontFamily="ManropeBold" FontSize="14.5" ReturnType="Done" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenIconCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RowIcon}" Style="{StaticResource RowKey}" />
                                <Image Grid.Column="1" Source="{Binding IconImage}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDurationCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RowDuration}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAlertCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.RowAlert}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding AlertText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" IsVisible="{Binding IsSoundRowsVisible}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsSoundRowsVisible}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSoundCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.Sound}" Style="{StaticResource RowKey}" />
                                <Label Grid.Column="1" Text="{Binding SoundText}" Style="{StaticResource RowValue}" />
                                <Image Grid.Column="2" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDivider}" IsVisible="{Binding IsSoundRowsVisible}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto" IsVisible="{Binding IsSoundRowsVisible}">
                                <Label Text="{x:Static res:AppResources.Vibration}" Style="{StaticResource RowKey}" />
                                <Switch Grid.Column="1" IsToggled="{Binding VibrationEnabled}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{x:Static res:AppResources.SaveFootnote}" Style="{StaticResource Footnote}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Действия: «Удалить» (только у существующего) и «Сохранить». -->
            <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="0,14,0,0">
                <Label Text="{Binding ErrorText}" TextColor="{StaticResource GoldInk}" IsVisible="{Binding HasError}" />
                <!-- Отступ у «Удалить» вместо ColumnSpacing: скрытая кнопка не оставляет зазора слева от «Сохранить». -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0">
                    <Border WidthRequest="54" HeightRequest="54" Margin="0,0,10,0" StrokeShape="RoundRectangle 18"
                            Background="{StaticResource CanvasBrush}" Stroke="{StaticResource Gold}" StrokeThickness="1"
                            IsVisible="{Binding IsExisting}" SemanticProperties.Description="{x:Static res:AppResources.DeleteAlarm}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="icon_trash.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Шторки поверх страницы; каждая получает модель через BindingContext. -->
        <controls:BottomSheet IsOpen="{Binding IsTimeSheetOpen}" Title="{x:Static res:AppResources.RowTime}"
                              Hint="{Binding TimeHint}" CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:TimeWheelSheet BindingContext="{Binding TimeSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsDateSheetOpen}" Title="{x:Static res:AppResources.RowDate}"
                              Hint="{Binding CalendarSheet.Hint}" CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:CalendarSheet BindingContext="{Binding CalendarSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsRepeatSheetOpen}" Title="{x:Static res:AppResources.RepeatHeader}"
                              CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:RepeatSheet BindingContext="{Binding RepeatSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsSoundSheetOpen}" Title="{x:Static res:AppResources.Sound}"
                              CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:SoundSheet BindingContext="{Binding SoundSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsDurationSheetOpen}" Title="{x:Static res:AppResources.RowDuration}"
                              CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:DurationSheet BindingContext="{Binding DurationSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsIconSheetOpen}" Title="{x:Static res:AppResources.RowIcon}"
                              CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:IconSheet BindingContext="{Binding IconSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
        <controls:BottomSheet IsOpen="{Binding IsAlertSheetOpen}" Title="{x:Static res:AppResources.RowAlert}"
                              CancelCommand="{Binding CloseSheetCommand}">
            <controls:BottomSheet.SheetContent>
                <sheets:AlertSheet BindingContext="{Binding AlertSheet}" />
            </controls:BottomSheet.SheetContent>
        </controls:BottomSheet>
    </Grid>
</ContentPage>
