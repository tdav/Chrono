<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,16" SafeAreaEdges="Container">
        <Label Text="{x:Static res:AppResources.SettingsTitle}" FontFamily="ManropeSemiBold" FontSize="24" Margin="0,0,0,12" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="10">
                <!-- Умное пробуждение: переключатель, описание, состояние доступа к данным часов. -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{x:Static res:AppResources.SmartWake}" FontFamily="ManropeSemiBold" FontSize="16" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding SmartWakeEnabled}" IsEnabled="{Binding IsSmartWakeSupported}"
                                    SemanticProperties.Description="{x:Static res:AppResources.SmartWake}" />
                        </Grid>
                        <Label Text="{x:Static res:AppResources.SmartWakeDescription}" Style="{StaticResource Muted}" FontSize="13" />
                        <Label Text="{Binding AccessText}" TextColor="{StaticResource Accent}" FontSize="13" />
                        <Button Text="{x:Static res:AppResources.GrantAccess}" Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Start" Padding="14,6" FontSize="13"
                                IsVisible="{Binding CanGrantAccess}" Command="{Binding GrantAccessCommand}" />
                        <Label Text="{x:Static res:AppResources.SmartWakePrivacy}" Style="{StaticResource Muted}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Отключение сигнала: пример с двузначными числами вместо простой кнопки «Стоп». -->
                <Label Text="{x:Static res:AppResources.DismissGroup}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox IsChecked="{Binding MathChallengeEnabled}" Color="{StaticResource Accent}" VerticalOptions="Center"
                                      SemanticProperties.Description="{x:Static res:AppResources.MathChallenge}" />
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.MathChallenge}" FontFamily="ManropeSemiBold" FontSize="16"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{x:Static res:AppResources.MathChallengeDescription}" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReliabilityCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.ReliabilityTitle}" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="{x:Static res:AppResources.Ok}" Style="{StaticResource PrimaryButton}"
                HorizontalOptions="End" Command="{Binding CloseCommand}" />
    </Grid>
</ContentPage>
