<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             x:Class="Chrono.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ContentPage.Resources>
        <!-- Сегменты «Оформление» (DESIGN.md §3 › Сегменты): выбранный — капсула SegmentThumb с подписью Semibold. -->
        <Style x:Key="ThemeThumb" TargetType="Border">
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SegmentThumb}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        </Style>
        <Style x:Key="ThemeText" TargetType="Label" BasedOn="{StaticResource TextSubheadline}">
            <Setter Property="TextColor" Value="{DynamicResource Label}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ThemeTextSelected" TargetType="Label" BasedOn="{StaticResource TextSubheadlineEmphasized}">
            <Setter Property="TextColor" Value="{DynamicResource Label}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <!-- Без заголовка вкладки: название уже есть в нижней панели. -->
    <Grid Padding="20,12,20,16" SafeAreaEdges="Container">

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <!-- Оформление: «Система» — как в телефоне, или своя светлая / тёмная тема. Трек 32 на TertiarySystemFill;
                     подпись невыбранного прячется, у выбранного она в капсуле; нажатие — по всему столбцу высотой 44. -->
                <Label Text="{x:Static res:AppResources.ThemeGroup}" Style="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="*,*,*" HeightRequest="{StaticResource SizeHit}" Margin="0,0,0,14">
                    <Border Grid.ColumnSpan="3" HeightRequest="{StaticResource SizeSegment}" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource TertiarySystemFill}" StrokeThickness="0" StrokeShape="RoundRectangle 16" />

                    <Label Text="{x:Static res:AppResources.ThemeSystem}" Style="{StaticResource ThemeText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsThemeSystem}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Style="{StaticResource ThemeThumb}" IsVisible="{Binding IsThemeSystem}">
                        <Label Text="{x:Static res:AppResources.ThemeSystem}" Style="{StaticResource ThemeTextSelected}" />
                    </Border>
                    <ContentView BackgroundColor="Transparent" SemanticProperties.Description="{x:Static res:AppResources.ThemeSystem}">
                        <ContentView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Unspecified" />
                        </ContentView.GestureRecognizers>
                    </ContentView>

                    <Label Grid.Column="1" Text="{x:Static res:AppResources.ThemeLight}" Style="{StaticResource ThemeText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsThemeLight}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Grid.Column="1" Style="{StaticResource ThemeThumb}" IsVisible="{Binding IsThemeLight}">
                        <Label Text="{x:Static res:AppResources.ThemeLight}" Style="{StaticResource ThemeTextSelected}" />
                    </Border>
                    <ContentView Grid.Column="1" BackgroundColor="Transparent" SemanticProperties.Description="{x:Static res:AppResources.ThemeLight}">
                        <ContentView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                        </ContentView.GestureRecognizers>
                    </ContentView>

                    <Label Grid.Column="2" Text="{x:Static res:AppResources.ThemeDark}" Style="{StaticResource ThemeText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsThemeDark}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Grid.Column="2" Style="{StaticResource ThemeThumb}" IsVisible="{Binding IsThemeDark}">
                        <Label Text="{x:Static res:AppResources.ThemeDark}" Style="{StaticResource ThemeTextSelected}" />
                    </Border>
                    <ContentView Grid.Column="2" BackgroundColor="Transparent" SemanticProperties.Description="{x:Static res:AppResources.ThemeDark}">
                        <ContentView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                        </ContentView.GestureRecognizers>
                    </ContentView>
                </Grid>

                <!-- Умное пробуждение: переключатель, описание, состояние доступа к данным часов. -->
                <Label Text="{x:Static res:AppResources.SmartWake}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{x:Static res:AppResources.SmartWake}" FontFamily="ManropeBold" FontSize="15" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding SmartWakeEnabled}" IsEnabled="{Binding IsSmartWakeSupported}"
                                    SemanticProperties.Description="{x:Static res:AppResources.SmartWake}" />
                        </Grid>
                        <Label Text="{x:Static res:AppResources.SmartWakeDescription}" Style="{StaticResource Muted}" FontSize="13" />
                        <Label Text="{Binding AccessText}" TextColor="{StaticResource GoldInk}" FontSize="13" />
                        <Button Text="{x:Static res:AppResources.GrantAccess}" Style="{StaticResource CompactAccentButton}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding CanGrantAccess}" Command="{Binding GrantAccessCommand}" />
                        <Label Text="{x:Static res:AppResources.SmartWakePrivacy}" Style="{StaticResource Footnote}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Отключение сигнала: пример с двузначными числами вместо простой кнопки «Стоп». -->
                <Label Text="{x:Static res:AppResources.DismissGroup}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox IsChecked="{Binding MathChallengeEnabled}" Color="{StaticResource Metal700}" VerticalOptions="Center"
                                      SemanticProperties.Description="{x:Static res:AppResources.MathChallenge}" />
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.MathChallenge}" FontFamily="ManropeBold" FontSize="15"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{x:Static res:AppResources.MathChallengeDescription}" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Синхронизация с Google Календарём: вход, состояние, выход. -->
                <Label Text="{x:Static res:AppResources.GoogleGroup}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Button Text="{x:Static res:AppResources.SignInGoogle}" Style="{StaticResource CompactAccentButton}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsSignedOut}" Command="{Binding SignInGoogleCommand}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsSignedIn}">
                            <Label Text="{x:Static res:AppResources.GoogleAccount}" Style="{StaticResource RowKey}" />
                            <Label Grid.Column="1" Text="{Binding GoogleEmail}" Style="{StaticResource RowValue}"
                                   HorizontalOptions="End" LineBreakMode="TailTruncation" />
                        </Grid>
                        <Label Text="{Binding SyncStatusText}" TextColor="{StaticResource GoldInk}" FontSize="13"
                               IsVisible="{Binding HasSyncStatus}" />
                        <Button Text="{x:Static res:AppResources.SignInAgainButton}" Style="{StaticResource CompactAccentButton}"
                                HorizontalOptions="Start"
                                IsVisible="{Binding NeedsSignInAgain}" Command="{Binding SignInGoogleCommand}" />
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsSignedIn}">
                            <Button Text="{x:Static res:AppResources.SyncNow}" Style="{StaticResource CompactAccentButton}"
                                    Command="{Binding SyncNowCommand}" />
                            <Button Text="{x:Static res:AppResources.SignOut}" Style="{StaticResource CompactAccentButton}"
                                    BorderColor="{StaticResource Hairline}" TextColor="{StaticResource Text}"
                                    Command="{Binding SignOutGoogleCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Переход к «Надёжности». -->
                <Border Style="{StaticResource RowGroup}" Margin="0,14,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReliabilityCommand}" />
                    </Border.GestureRecognizers>
                    <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.ReliabilityTitle}" Style="{StaticResource RowTitle}" />
                        <Image Grid.Column="1" Source="icon_chevron.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
