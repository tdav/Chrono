<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:res="clr-namespace:Chrono.Resources.Strings"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             x:Class="Chrono.Views.DialPage"
             x:DataType="vm:DialViewModel">

    <!-- DESIGN.md §4.10. Шапка лежит поверх прокрутки: сегменты, циферблат и карточка прокручиваются вместе, Large Title сворачивается.
         Первым элементом содержимого — отступ высотой в шапку. -->
    <Grid SafeAreaEdges="Container">
        <!-- Объявлена первой, чтобы на неё можно было сослаться из отступа ниже, и поднята над прокруткой через ZIndex;
             прокрутку страница передаёт шапке в коде. -->
        <controls:LargeTitleHeader x:Name="Header" VerticalOptions="Start" ZIndex="1"
                                   Title="{x:Static res:AppResources.Tab_Dial}" Subtitle="{Binding TitleDate}">
            <controls:LargeTitleHeader.TrailingContent>
                <controls:GlassIconButton Source="icon_plus.png" Description="{x:Static res:AppResources.DialAdd}"
                                          Command="{Binding AddCommand}" />
            </controls:LargeTitleHeader.TrailingContent>
        </controls:LargeTitleHeader>

        <ScrollView x:Name="Scroll" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,0,0,24" Spacing="{StaticResource Space4}">
                <Grid HeightRequest="{Binding HeaderHeight, Source={x:Reference Header}, x:DataType=controls:LargeTitleHeader, Mode=OneWay}" />

                <!-- Сегменты: «Сейчас» — половина суток с текущим временем, «Вечер» — 12:00–24:00. Подписи задаёт код страницы. -->
                <controls:SegmentedControl x:Name="Halves" Margin="16,0" SelectedIndex="{Binding HalfIndex}" />

                <!-- Циферблат; подписи в центре лежат поверх и касания пропускают. -->
                <Grid Margin="16,0">
                    <GraphicsView x:Name="Dial" HeightRequest="300" SemanticProperties.Description="{Binding DialDescription}">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDialTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <!-- Без выбора — время и идущее дело; с выбором — название и интервал записи. Ширина — между цифрами 9 и 3. -->
                    <VerticalStackLayout WidthRequest="136" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center"
                                         InputTransparent="True" CascadeInputTransparent="True">
                        <Label Text="{Binding CenterTitle}" Style="{StaticResource TextTitle1}" TextColor="{DynamicResource Label}"
                               HorizontalOptions="Center" IsVisible="{Binding IsIdle}" />
                        <Label Text="{Binding CenterTitle}" Style="{StaticResource TextHeadline}" TextColor="{DynamicResource Label}"
                               HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation"
                               IsVisible="{Binding HasSelection}" />
                        <Label Text="{Binding CenterSub}" Style="{StaticResource Footnote}"
                               HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Без выбора: «сейчас» и ближайшие дела; нажатие на строку — редактор этого дела. -->
                <Border Style="{StaticResource Section}" Margin="16,0" IsVisible="{Binding IsIdle}">
                    <VerticalStackLayout>
                        <!-- Жест — на строке высотой от 52: зона касания больше 44. -->
                        <Grid Style="{StaticResource Row}" BackgroundColor="Transparent"
                              SemanticProperties.Hint="{x:Static res:AppResources.DialTapToEdit}">
                            <Label Text="{Binding IdleHeadline.Text}" Style="{StaticResource RowTitle}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEntryCommand}" CommandParameter="{Binding IdleHeadline}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding IdleLines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DialIdleLine">
                                    <VerticalStackLayout>
                                        <BoxView Style="{StaticResource RowSeparator}" />
                                        <Grid Style="{StaticResource Row}" BackgroundColor="Transparent"
                                              SemanticProperties.Hint="{x:Static res:AppResources.DialTapToEdit}">
                                            <Label Text="{Binding Text}" Style="{StaticResource RowSubtitle}" VerticalOptions="Center" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenEntryCommand, Source={RelativeSource AncestorType={x:Type vm:DialViewModel}}, x:DataType=vm:DialViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- С выбором: точка категории, название, подробности и действия. -->
                <Border Style="{StaticResource Section}" Margin="16,0" IsVisible="{Binding HasSelection}">
                    <VerticalStackLayout Padding="16,12,12,8" Spacing="{StaticResource Space1}">
                        <!-- Подпись доступности — на заголовке, не на Border: на iOS описание контейнера скрывает от VoiceOver кнопки внутри. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,4,0"
                              SemanticProperties.Description="{Binding CardDescription}">
                            <Border WidthRequest="12" HeightRequest="12" VerticalOptions="Center" StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                    design:CategoryColor.Index="{Binding SelectedCategory}" />
                            <Label Grid.Column="1" Text="{Binding SelectedTitle}" Style="{StaticResource TextHeadline}"
                                   TextColor="{DynamicResource Label}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding SelectedDetails}" Style="{StaticResource RowSubtitle}" Margin="0,0,4,0" />
                        <!-- Действия справа: «Изменить» — главное, крайнее справа. Поля 4 вокруг кнопок добирают область нажатия до 44;
                             на крупном шрифте кнопки переносятся на следующую строку. -->
                        <FlexLayout Wrap="Wrap" JustifyContent="End" AlignItems="Center">
                            <Button Text="{x:Static res:AppResources.DialClearSelection}" Style="{StaticResource PlainButtonM}" Margin="4,5"
                                    Command="{Binding ClearSelectionCommand}" />
                            <Button Text="{Binding SelectedDoneText}" Style="{StaticResource GrayButtonM}" Margin="4,5"
                                    Command="{Binding ToggleDoneCommand}" />
                            <Button Text="{x:Static res:AppResources.DialEdit}" Style="{StaticResource FilledButtonM}" Margin="4,5"
                                    Command="{Binding EditCommand}" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
