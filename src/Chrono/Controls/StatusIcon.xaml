<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             x:Class="Chrono.Controls.StatusIcon"
             x:Name="Root" x:DataType="controls:StatusIcon"
             WidthRequest="{StaticResource SizeRowIcon}" HeightRequest="{StaticResource SizeRowIcon}"
             HorizontalOptions="Start" VerticalOptions="Center"
             AutomationProperties.IsInAccessibleTree="False">
    <!-- Цветной значок строки (DESIGN.md §2.5, §2.6): квадрат 30 × 30 с радиусом 7 (icon) и символом цвета GlyphColor
         (роль «на заливке»: OnTint на Success, OnWarning на Warning, по умолчанию OnColor).
         Статус всегда продублирован словами рядом, поэтому сам значок для чтения с экрана скрыт.
         Заливка — роль цвета через {DynamicResource …} (Success, Warning, Indigo …): она перекрашивается вместе с темой. -->
    <ContentView.Content>
        <Border BackgroundColor="{Binding Fill, Source={x:Reference Root}}" StrokeThickness="0" StrokeShape="RoundRectangle 7">
            <Image Source="{Binding Source, Source={x:Reference Root}}" WidthRequest="18" HeightRequest="18"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   design:IconTint.Color="{Binding GlyphColor, Source={x:Reference Root}}" />
        </Border>
    </ContentView.Content>
</ContentView>
