<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Chrono.Controls"
             xmlns:design="clr-namespace:Chrono.Design"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             x:Class="Chrono.Controls.PopupMenu"
             x:Name="Root" x:DataType="controls:PopupMenu" IsVisible="False">
    <!-- Меню (DESIGN.md §3 › Меню): стекло GlassFillLarge, радиус 26, тень shadowPopover, поля 6, пункт от 44 с радиусом подсветки 14.
         Галочка выбранного — в ведущей колонке 16 цветом Label, подпись — Body. Меню кладётся поверх страницы в её корневой Grid (как BottomSheet),
         открывается от якоря (Anchor): под ним, а если не помещается — над ним, по правому краю якоря. Прозрачная подложка ловит нажатие вне меню. -->
    <ContentView.Content>
        <Grid>
            <BoxView Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="Menu" WidthRequest="250" Padding="6" HorizontalOptions="Start" VerticalOptions="Start" StrokeShape="RoundRectangle 26"
                    BackgroundColor="{DynamicResource GlassFillLarge}" Stroke="{DynamicResource GlassEdge}" StrokeThickness="{DynamicResource HairlineWidth}"
                    SemanticProperties.Description="{Binding Description, Source={x:Reference Root}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,12" Radius="48" Opacity="0.18" />
                </Border.Shadow>
                <!-- Пустой обработчик нажатия: тап по меню не должен проваливаться в подложку и закрывать его. -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceOption">
                            <!-- Пункт: подсветка QuaternarySystemFill на время нажатия ставит код; область нажатия — весь пункт. -->
                            <Border MinimumHeightRequest="{StaticResource SizeHit}" Padding="12,0" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                    SemanticProperties.Description="{Binding Name}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                    <PointerGestureRecognizer PointerPressed="OnItemPressed" PointerReleased="OnItemReleased" PointerExited="OnItemReleased" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="12" MinimumHeightRequest="{StaticResource SizeHit}">
                                    <Image Source="icon_check.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" InputTransparent="True"
                                           design:IconTint.Color="{DynamicResource Label}" IsVisible="{Binding IsSelected}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowTitle}" InputTransparent="True" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentView.Content>
</ContentView>
